{% extends '@EasyAdmin/page/content.html.twig' %}

{% block body_id 'regenerate-fixtures' %}

{% block content_title %}{{ 'fixtures.title'|trans }}{% endblock %}

{% block main %}
    <p>{{ 'fixtures.description'|trans }}</p>

    <p>{{ 'fixtures.description_extended'|trans|raw }}</p>

    <form method="post" action="{{ path('admin_regenerate_fixtures') }}">
        <input type="hidden" name="_token" value="{{ csrf_token('regenerate_fixtures') }}">
        <twig:ea:Button color="primary">{{ 'fixtures.submit'|trans }}</twig:ea:Button>
    </form>
{% endblock %}
