{% extends '@EasyAdmin/page/content.html.twig' %}

{% block body_id 'order-print' %}
{% block body_class 'page-content order-print' %}

{% block content_title %}{{ 'order.print.title'|trans({number: order.number}) }}{% endblock %}

{% block page_actions %}
    <twig:ea:Button htmlElement="a" href="{{ path('admin_order_detail', {entityId: order.id}) }}">{{ 'order.print.back'|trans }}</twig:ea:Button>
    <twig:ea:Button type="button" color="primary" icon="printer" onclick="window.print()">{{ 'action.print'|trans }}</twig:ea:Button>
{% endblock %}

{% block main %}
    {% set customer = order.customer %}

    <div class="row mb-4">
        <div class="col-md-6">
            <h2 class="h5">{{ 'order.customer'|trans }}</h2>
            <p class="mb-1">{{ customer.name }}</p>
            <p class="mb-1">{{ customer.email }}</p>

            {% if customer.address %}
                <address class="mb-0">
                    {{ customer.address.street }}<br>
                    {{ customer.address.postalCode }} {{ customer.address.city }}<br>
                    <twig:ea:Flag :countryCode="customer.address.country" showName />
                </address>
            {% endif %}
        </div>

        <div class="col-md-6">
            <h2 class="h5">{{ 'order.fieldset.details'|trans }}</h2>
            <p class="mb-1">{{ 'order.placedAt'|trans }}: {{ order.placedAt|format_datetime('medium', 'short') }}</p>

            {% if order.shippedOn %}
                <p class="mb-1">{{ 'order.shippedOn'|trans }}: {{ order.shippedOn|format_date('medium') }}</p>
            {% endif %}

            <twig:ea:Badge color="{{ order.status.color }}">{{ order.status.label|trans }}</twig:ea:Badge>
        </div>
    </div>

    <table class="table">
        <thead>
            <tr>
                <th scope="col">{{ 'order.line.product'|trans }}</th>
                <th scope="col" class="text-end">{{ 'order.line.quantity'|trans }}</th>
                <th scope="col" class="text-end">{{ 'order.line.unitPrice'|trans }}</th>
                <th scope="col" class="text-end">{{ 'order.line.subtotal'|trans }}</th>
            </tr>
        </thead>
        <tbody>
            {% for line in order.lines %}
                <tr>
                    <td>{{ line.product.name }}</td>
                    <td class="text-end">{{ line.quantity }}</td>
                    <td class="text-end">{{ (line.unitPrice / 100)|format_currency(order.currency) }}</td>
                    <td class="text-end">{{ (line.subtotal / 100)|format_currency(order.currency) }}</td>
                </tr>
            {% endfor %}
        </tbody>
        <tfoot>
            <tr>
                <th scope="row" colspan="3" class="text-end">{{ 'order.total'|trans }}</th>
                <td class="text-end fw-semibold">{{ (order.total / 100)|format_currency(order.currency) }}</td>
            </tr>
        </tfoot>
    </table>
{% endblock %}
